<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Tirki.Views.CategoryEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Tirki.ViewModels"
    x:DataType="vm:CategoryEditViewModel"
    Title="{Binding Title}">

    <VerticalStackLayout Padding="20" Spacing="16">

        <Label Text="Nome" FontAttributes="Bold" />
        <Entry Text="{Binding Name}" Placeholder="Es. Spesa, Trasporti..." />

        <Label Text="Colore" FontAttributes="Bold" />
        <FlexLayout BindableLayout.ItemsSource="{Binding Colors}" Wrap="Wrap" JustifyContent="Start">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Border
                        StrokeShape="RoundRectangle 20"
                        Stroke="{AppThemeBinding Light=Black, Dark=White}"
                        BackgroundColor="{Binding .}"
                        WidthRequest="40"
                        HeightRequest="40"
                        Margin="0,0,10,10">
                        <Border.StrokeThickness>
                            <MultiBinding Converter="{StaticResource StringEqualsConverter}">
                                <Binding Path="." />
                                <Binding Path="SelectedColorHex" Source="{RelativeSource AncestorType={x:Type vm:CategoryEditViewModel}}" />
                            </MultiBinding>
                        </Border.StrokeThickness>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CategoryEditViewModel}}, Path=SelectColorCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </FlexLayout>

        <Button Text="Salva" Command="{Binding SaveCommand}" Margin="0,20,0,0" />
        <Button Text="Annulla" Command="{Binding CancelCommand}" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#512BD4, Dark=White}" />
        <Button
            Text="Elimina"
            Command="{Binding DeleteCommand}"
            IsVisible="{Binding IsExisting}"
            BackgroundColor="#D9534F" />

    </VerticalStackLayout>

</ContentPage>
