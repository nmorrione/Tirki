<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Tirki.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Tirki.ViewModels"
    xmlns:models="clr-namespace:Tirki.Models"
    x:DataType="vm:TransactionsViewModel"
    Title="Tirki">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{Binding EyeGlyph}" Command="{Binding ToggleBalanceVisibilityCommand}" Order="Primary" Priority="0" />
        <ToolbarItem Text="⚙" Command="{Binding OpenSettingsCommand}" Order="Primary" Priority="1" />
        <ToolbarItem Text="+" Command="{Binding AddTransactionCommand}" Order="Primary" Priority="2" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <VerticalStackLayout Grid.Row="0" Padding="20" Spacing="4" BackgroundColor="{AppThemeBinding Light=#512BD4, Dark=#3D1F9E}">
            <Label Text="Saldo attuale" TextColor="White" Opacity="0.8" FontSize="14" />
            <Label Text="{Binding DisplayBalance}" TextColor="White" FontSize="34" FontAttributes="Bold" />
        </VerticalStackLayout>

        <Grid Grid.Row="1" Padding="16,10" ColumnDefinitions="*,*,Auto" ColumnSpacing="10" BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#1C1C1E}">
            <VerticalStackLayout Grid.Column="0" Spacing="0">
                <Label Text="Da" FontSize="11" Opacity="0.6" />
                <DatePicker Date="{Binding FilterFrom}" Format="dd/MM/yyyy" FontSize="13" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="0">
                <Label Text="A" FontSize="11" Opacity="0.6" />
                <DatePicker Date="{Binding FilterTo}" Format="dd/MM/yyyy" FontSize="13" />
            </VerticalStackLayout>
            <Button
                Grid.Column="2"
                Text="Mese corrente"
                Command="{Binding SetCurrentMonthCommand}"
                FontSize="12"
                VerticalOptions="Center" />
        </Grid>

        <Grid
            Grid.Row="2"
            Padding="16,8"
            ColumnDefinitions="*,Auto"
            BackgroundColor="{AppThemeBinding Light=#E2DEF7, Dark=#2A1F5C}"
            IsVisible="{Binding IsCurrentSectionVisible}">
            <Label Grid.Column="0" Text="{Binding CurrentSectionName}" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#512BD4, Dark=White}" />
            <Label Grid.Column="1" Text="{Binding CurrentSectionTotal, Converter={StaticResource CurrencyConverter}}" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#512BD4, Dark=White}" />
        </Grid>

        <Grid Grid.Row="3">
            <CollectionView x:Name="TransactionsCollectionView" ItemsSource="{Binding Groups}" IsGrouped="True" Scrolled="OnTransactionsScrolled">

                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="{x:Type vm:TransactionGroup}">
                        <Grid ColumnDefinitions="*,Auto" Padding="16,10" BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#1C1C1E}">
                            <Label Text="{Binding Name}" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="{Binding Total, Converter={StaticResource CurrencyConverter}}" FontAttributes="Bold" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Transaction">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem
                                        Text="Elimina"
                                        BackgroundColor="#D9534F"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransactionsViewModel}}, Path=DeleteTransactionCommand}"
                                        CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Grid
                                Padding="16,12"
                                ColumnDefinitions="*,Auto"
                                RowDefinitions="Auto,Auto"
                                BackgroundColor="{Binding Amount, Converter={StaticResource AmountBackgroundColorConverter}}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransactionsViewModel}}, Path=EditTransactionCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Description}" FontSize="16" />
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding Date, StringFormat='{0:d MMM yyyy}'}" FontSize="12" Opacity="0.6" />
                                <Label
                                    Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                    Text="{Binding Amount, Converter={StaticResource CurrencyConverter}}"
                                    VerticalTextAlignment="Center"
                                    FontAttributes="Bold" />
                            </Grid>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </Grid>
    </Grid>

</ContentPage>
