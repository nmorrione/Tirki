<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Tirki.Views.CategoriesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Tirki.ViewModels"
    xmlns:models="clr-namespace:Tirki.Models"
    x:DataType="vm:CategoriesViewModel"
    Title="Categorie">

    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="{AppThemeBinding Light=icon_plus.svg, Dark=icon_plus_dark.svg}" Command="{Binding AddCategoryCommand}" />
    </ContentPage.ToolbarItems>

    <CollectionView ItemsSource="{Binding Categories}">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:Category">
                <SwipeView>
                    <SwipeView.RightItems>
                        <SwipeItems>
                            <SwipeItem
                                Text="Elimina"
                                BackgroundColor="#D9534F"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CategoriesViewModel}}, Path=DeleteCategoryCommand}"
                                CommandParameter="{Binding .}" />
                        </SwipeItems>
                    </SwipeView.RightItems>

                    <Grid Padding="16,14" ColumnDefinitions="Auto,*">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CategoriesViewModel}}, Path=EditCategoryCommand}"
                                CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>

                        <BoxView
                            Grid.Column="0"
                            BackgroundColor="{Binding ColorHex}"
                            WidthRequest="20"
                            HeightRequest="20"
                            CornerRadius="10"
                            VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding Name}" FontSize="16" Margin="14,0,0,0" VerticalOptions="Center" />
                    </Grid>
                </SwipeView>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>
