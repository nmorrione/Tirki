<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Tirki.Views.TrendPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Tirki.ViewModels"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    x:DataType="vm:TrendViewModel"
    Title="Andamento">

    <VerticalStackLayout Spacing="0">

        <Grid Padding="16,10" ColumnDefinitions="*" BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#1C1C1E}">
            <VerticalStackLayout Spacing="0">
                <Label Text="Periodo" FontSize="11" Opacity="0.6" />
                <Picker ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding SelectedPeriod}" />
            </VerticalStackLayout>
        </Grid>

        <Label
            Text="Nessun dato disponibile."
            Padding="20,40"
            Opacity="0.6"
            HorizontalTextAlignment="Center"
            IsVisible="{Binding HasData, Converter={StaticResource InverseBoolConverter}}" />

        <lvc:CartesianChart
            Series="{Binding Series}"
            XAxes="{Binding XAxes}"
            HeightRequest="340"
            Margin="10,20"
            IsVisible="{Binding HasData}" />

    </VerticalStackLayout>

</ContentPage>
