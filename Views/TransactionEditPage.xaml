<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Tirki.Views.TransactionEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Tirki.ViewModels"
    xmlns:models="clr-namespace:Tirki.Models"
    x:DataType="vm:TransactionEditViewModel"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Descrizione" FontAttributes="Bold" />
            <Entry Text="{Binding Description}" Placeholder="Es. Spesa, Stipendio, Affitto..." />

            <Label Text="Data" FontAttributes="Bold" />
            <DatePicker Date="{Binding Date}" Format="dd/MM/yyyy" />

            <Label Text="Tipo" FontAttributes="Bold" />
            <HorizontalStackLayout Spacing="10">
                <RadioButton Content="Uscita" GroupName="tipo" IsChecked="{Binding IsIncome, Converter={StaticResource InverseBoolConverter}}" />
                <RadioButton Content="Entrata" GroupName="tipo" IsChecked="{Binding IsIncome}" />
            </HorizontalStackLayout>

            <Label Text="Importo" FontAttributes="Bold" />
            <Entry Text="{Binding AmountText}" Keyboard="Numeric" Placeholder="0,00" />

            <Button Text="Salva" Command="{Binding SaveCommand}" Margin="0,20,0,0" />
            <Button Text="Salva come preset" Command="{Binding SaveAsPresetCommand}" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#512BD4, Dark=White}" FontSize="13" />
            <Button Text="Annulla" Command="{Binding CancelCommand}" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#512BD4, Dark=White}" />
            <Button
                Text="Elimina"
                Command="{Binding DeleteCommand}"
                IsVisible="{Binding IsExisting}"
                BackgroundColor="#D9534F" />

            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2DEF7, Dark=#2A1F5C}" Margin="0,10" IsVisible="{Binding Presets.Count}" />

            <Label Text="Preset spese ricorrenti" FontAttributes="Bold" IsVisible="{Binding Presets.Count}" />

            <CollectionView ItemsSource="{Binding Presets}" ItemsLayout="HorizontalList" IsVisible="{Binding Presets.Count}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TransactionPreset">
                        <Border
                            StrokeShape="RoundRectangle 16"
                            Padding="12,8"
                            Margin="0,0,8,0"
                            BackgroundColor="{Binding Amount, Converter={StaticResource AmountBackgroundColorConverter}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransactionEditViewModel}}, Path=ApplyPresetCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="8">
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="{Binding Description}" FontSize="13" />
                                    <Label Text="{Binding Amount, Converter={StaticResource CurrencyConverter}}" FontSize="13" FontAttributes="Bold" />
                                </VerticalStackLayout>
                                <Label Text="✕" FontSize="13" Opacity="0.5" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransactionEditViewModel}}, Path=DeletePresetCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
