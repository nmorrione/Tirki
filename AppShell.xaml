<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Tirki.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Tirki.Views"
    Title="Tirki">

    <TabBar>
        <ShellContent
            Title="Home"
            Icon="{AppThemeBinding Light=icon_home.svg, Dark=icon_home_dark.svg}"
            ContentTemplate="{DataTemplate views:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="Categorie"
            Icon="{AppThemeBinding Light=icon_stats.svg, Dark=icon_stats_dark.svg}"
            ContentTemplate="{DataTemplate views:CategoryStatsPage}"
            Route="CategoryStatsPage" />
    </TabBar>

</Shell>
